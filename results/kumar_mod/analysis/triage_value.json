{
  "script": "pipeline/kumar_mod/triage_value.py",
  "question": "human-hours-saved / triage value: cheap-encoder triage vs LLM-only at a fixed TOTAL-SYSTEM quality bar, on Kumar's balanced TEST fold",
  "split": "slm_mod_split.parquet (fixed 80/20), TEST fold only (train fold used only to fit heads)",
